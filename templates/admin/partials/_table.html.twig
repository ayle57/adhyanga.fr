<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="{{ search|default('') }}" class="form-control" placeholder="Rechercher un client...">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Rechercher</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
        <tr>
            {% for header in headers %}
                <th scope="col">{{ header }}</th>
            {% endfor %}
        </tr>
        </thead>
        <tbody>
        {% if pagination.items is not empty %}
            {% for row in pagination.items %}
                <tr>
                    <td>{{ row.id }}</td>
                    <td>{{ row.lastname }}</td>
                    <td>{{ row.firstname }}</td>
                    <td>{{ row.createdAt ? row.createdAt|date('d/m/Y H:i') : '-' }}</td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="{{ headers|length }}" class="text-center">
                    Aucune donnée disponible
                </td>
            </tr>
        {% endif %}
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div>
        <small class="text-muted">
            Affichage
            {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + 1 }}
            à
            {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + pagination.items|length }}
            sur {{ pagination.getTotalItemCount }} résultats
        </small>
    </div>

    <div>
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
    </div>

</div>
