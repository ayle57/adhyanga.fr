{% extends 'admin/base.html.twig' %}

{% block title %}Client {{ customer.id }}{% endblock %}

{% block body %}
    {% include "admin/partials/_navbar.html.twig" %}

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Client #{{ customer.id }}</h1>
            <a href="{{ path('admin_customers_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">{{ customer.firstname }} {{ customer.lastname }}</h5>
                <p class="card-text">
                    <strong>ID :</strong> {{ customer.id }}<br>
                    <strong>Prénom :</strong> {{ customer.firstname }}<br>
                    <strong>Nom :</strong> {{ customer.lastname }}<br>
                    <strong>Email :</strong> {{ customer.email|default('-') }}<br>
                    <strong>Téléphone :</strong> {{ customer.phone|default('-') }}<br>
                    <strong>Créé le :</strong> {{ customer.createdAt ? customer.createdAt|date('d/m/Y H:i') : '-' }}<br>
                    <strong>Mis à jour le :</strong> {{ customer.updatedAt ? customer.updatedAt|date('d/m/Y H:i') : '-' }}
                </p>
                {% if customer.appointments|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Début</th>
                                <th>Fin</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for appointment in customer.appointments %}
                                <tr style="cursor:pointer;"
                                    onclick="window.location='{{ path('admin_appointments_show', {'id': appointment.id}) }}'">

                                    <td>#{{ appointment.id }}</td>

                                    <td>
                                        {{ appointment.startTime ? appointment.startTime|date('d/m/Y H:i') : '-' }}
                                    </td>

                                    <td>
                                        {{ appointment.endTime ? appointment.endTime|date('d/m/Y H:i') : '-' }}
                                    </td>

                                    <td>
                                        {% set status = appointment.status.value %}
                                        <span class="badge
                                        {% if status == 'scheduled' %}bg-primary
                                        {% elseif status == 'done' %}bg-success
                                        {% elseif status == 'canceled' %}bg-danger
                                        {% endif %}">
                                        {{ appointment.status.label() }}
                                    </span>
                                    </td>

                                    <td class="text-end">
                                        <a href="{{ path('admin_appointments_show', {'id': appointment.id}) }}"
                                           class="btn btn-sm btn-outline-primary"
                                           onclick="event.stopPropagation();">
                                            Voir
                                        </a>
                                    </td>

                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="p-3 text-muted text-center">
                        Aucun rendez-vous pour ce client.
                    </div>
                {% endif %}
            </div>
            <div class="card-footer text-end">
                <a href="{{ path('admin_customers_edit', {'id': customer.id}) }}" class="btn btn-secondary">Modifier</a>
                <a href="{{ path('admin_customers_notes_edit', {"id": customer.id}) }}" class="btn btn-primary">Accès aux notes</a>
            </div>
        </div>

    </div>
{% endblock %}
