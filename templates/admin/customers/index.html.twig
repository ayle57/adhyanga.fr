{% extends 'admin/base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
    {% include "admin/partials/_navbar.html.twig" %}

    <div class="container mt-4">

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-2">
                <label>
                    <input type="text"
                           name="q"
                           value="{{ search|default('') }}"
                           class="form-control"
                           placeholder="Rechercher un client...">
                </label>
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary">Rechercher</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                <tr>
                    {% for header in ["ID", "Nom", "Prénom", "Créé le"] %}
                        <th scope="col">{{ header }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% if pagination.items is not empty %}
                    {% for row in pagination.items %}
                        <tr class="table-row" style="cursor: pointer;" onclick="window.location='{{ path('admin_customers_show', {'id': row.id}) }}'">
                            <td>{{ row.id }}</td>
                            <td>{{ row.lastname }}</td>
                            <td>{{ row.firstname }}</td>
                            <td>{{ row.createdAt ? row.createdAt|date('d/m/Y H:i') : '-' }}</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucune donnée disponible</td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                Affichage
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + 1 }}
                à
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + pagination.items|length }}
                sur {{ pagination.getTotalItemCount }} résultats
            </small>

            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
{% endblock %}
