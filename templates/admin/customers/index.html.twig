{% extends 'admin/base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
    {% include "admin/partials/_navbar.html.twig" %}

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <form method="get" class="d-flex w-75 me-3">
                <input type="text"
                       name="q"
                       value="{{ search|default('') }}"
                       class="form-control me-2"
                       placeholder="Rechercher un client..."
                       style="flex-grow: 1;">
                <button class="btn btn-primary">Rechercher</button>
            </form>

            <a href="{{ path('admin_customers_create') }}" class="btn btn-success">
                Nouveau client
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                <tr>
                    {% for header in ["ID", "Nom", "Prénom", "Créé le", ""] %}
                        <th scope="col">{{ header }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% if pagination.items is not empty %}
                    {% for row in pagination.items %}
                        <tr class="table-row align-middle"
                            style="cursor: pointer;"
                            onclick="window.location='{{ path('admin_customers_show', {'id': row.id}) }}'">

                            <td>{{ row.id }}</td>
                            <td>{{ row.lastname }}</td>
                            <td>{{ row.firstname }}</td>
                            <td>{{ row.createdAt ? row.createdAt|date('d/m/Y H:i') : '-' }}</td>

                            <td class="text-end">
                                <a href="{{ path('admin_customers_show', {'id': row.id}) }}"
                                   class="btn btn-sm btn-outline-primary"
                                   onclick="event.stopPropagation();">
                                    Voir
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Aucune donnée disponible</td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                Affichage
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + 1 }}
                à
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + pagination.items|length }}
                sur {{ pagination.getTotalItemCount }} résultats
            </small>

            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
{% endblock %}
