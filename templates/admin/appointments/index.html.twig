{% extends 'admin/base.html.twig' %}

{% block title %}Rendez-vous{% endblock %}

{% block body %}
    {% include "admin/partials/_navbar.html.twig" %}

    <div class="container mt-4">

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-2">
                <input type="text"
                       name="q"
                       value="{{ search|default('') }}"
                       class="form-control"
                       placeholder="Rechercher un client...">
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary">Rechercher</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                <tr>
                    {% for header in ["ID", "Nom", "Prénom", "Statut", "Créé le", ""] %}
                        <th scope="col">{{ header }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% if pagination.items is not empty %}
                    {% for row in pagination.items %}
                        <tr class="table-row align-middle" style="cursor: pointer;">
                            <td>{{ row.id }}</td>
                            <td>{{ row.customer.lastname }}</td>
                            <td>{{ row.customer.firstname }}</td>
                            <td>
                                <select class="form-select status-select"
                                        data-id="{{ row.id }}"
                                        onchange="updateStatus(event, this)">
                                    <option value="scheduled" {% if row.status.value == 'scheduled' %}selected{% endif %}>Programmé</option>
                                    <option value="done" {% if row.status.value == 'done' %}selected{% endif %}>Terminé</option>
                                    <option value="canceled" {% if row.status.value == 'canceled' %}selected{% endif %}>Annulé</option>
                                </select>
                            </td>
                            <td>{{ row.createdAt ? row.createdAt|date('d/m/Y H:i') : '-' }}</td>
                            <td class="text-end">
                                <a href="{{ path('admin_appointments_show', {'id': row.id}) }}"
                                   class="btn btn-sm btn-outline-primary"
                                   onclick="event.stopPropagation();">
                                    Voir
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucune donnée disponible</td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                Affichage
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + 1 }}
                à
                {{ pagination.getItemNumberPerPage * (pagination.getCurrentPageNumber - 1) + pagination.items|length }}
                sur {{ pagination.getTotalItemCount }} résultats
            </small>

            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const badge = document.querySelector('.status-badge');
            if (!badge) return;

            badge.addEventListener('click', function(e) {
                e.stopPropagation();
                const id = this.dataset.id;
                const status = this.dataset.status;

                const nextStatus = {
                    'scheduled': 'done',
                    'done': 'canceled',
                    'canceled': 'scheduled'
                };
                const newStatus = nextStatus[status];

                fetch('{{ path("admin_appointments_update_status", {"id": 0}) }}'.replace('/0', '/' + id), {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': '{{ csrf_token("update_status") }}'
                    },
                    body: JSON.stringify({ status: newStatus })
                })
                    .then(resp => resp.json())
                    .then(data => {
                        if(data.success){
                            badge.textContent = data.label;
                            badge.dataset.status = data.status;
                            badge.classList.remove('bg-primary', 'bg-success', 'bg-danger');
                            if(data.status === 'scheduled') badge.classList.add('bg-primary');
                            else if(data.status === 'done') badge.classList.add('bg-success');
                            else if(data.status === 'canceled') badge.classList.add('bg-danger');
                        } else {
                            alert(data.message || 'Erreur lors de la mise à jour du statut');
                        }
                    })
                    .catch(err => { console.error(err); alert('Erreur lors de la mise à jour du statut'); });
            });
        });
    </script>
{% endblock %}
